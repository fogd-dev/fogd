{
  "name": "fogd-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "fogd": "node packages/cli/bin/fogd.js",
    "check": "node scripts/check.mjs",
    "test": "node --test packages/*/test/*.test.mjs examples/guestbook/updates/attachments/*.test.mjs",
    "build": "pnpm check && pnpm --filter \"@fogd/example-*\" build"
  },
  "devDependencies": {
    "@fogd/cli": "workspace:*",
    "@playwright/test": "1.64.1",
    "vite": "8.1.0",
    "void": "1.1.11"
  }
}
