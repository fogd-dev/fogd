# Local defaults only. Set private credentials before sharing the stack.
COMPOSE_PROJECT_NAME=fogd
FOGD_BIND_ADDRESS=127.0.0.1
FOGD_HTTP_PORT=8787
FOGD_APP=hello
FOGD_APP_HOST=hello.localhost
FOGD_BUCKET=fogd
FOGD_BUCKET_ENDPOINT=http://minio:9000
FOGD_BUCKET_USER=fogd-local
FOGD_BUCKET_PASSWORD=fogd-local-development-only
FOGD_NODE_A=celld-a:8080
FOGD_NODE_B=celld-b:8080
FOGD_NODE_A_ADVERTISE=celld-a:8081
FOGD_NODE_B_ADVERTISE=celld-b:8081
FOGD_CELLD_MEMORY=512m
FOGD_CELLD_CPUS=1
FOGD_CELLD_HEAP_MB=128
FOGD_MAX_RESIDENT_CELLS=100
# Stable within each fleet; retain these with the corresponding replica log volumes.
FOGD_NODE_A_ID=node-a
FOGD_NODE_B_ID=node-b
