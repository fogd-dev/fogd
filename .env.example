# fogd up generates missing admin/deploy/gateway secrets in .env (mode 0600).
# For docker compose up directly, set those three nonempty values first.
COMPOSE_PROJECT_NAME=fogd
FOGD_BIND_ADDRESS=127.0.0.1
FOGD_HTTP_PORT=8787
FOGD_ADMIN_PORT=8788
FOGD_BASE_DOMAIN=localhost
FOGD_ADMIN_USER=admin
# FOGD_ADMIN_PASSWORD=
# FOGD_DEPLOY_TOKEN=
# FOGD_GATEWAY_TOKEN=
FOGD_BUCKET=fogd
FOGD_BUCKET_ENDPOINT=http://minio:9000
FOGD_BUCKET_REGION=us-east-1
FOGD_BUCKET_USER=fogd-local
FOGD_BUCKET_PASSWORD=fogd-local-development-only
FOGD_SLOT_1_PREFIX=slots/slot-1
FOGD_SLOT_2_PREFIX=slots/slot-2
FOGD_SLOT_1_A_HOST=slot-1-a
FOGD_SLOT_1_B_HOST=slot-1-b
FOGD_SLOT_2_A_HOST=slot-2-a
FOGD_SLOT_2_B_HOST=slot-2-b
# Retain these identities, advertised addresses, and their replica volumes together.
FOGD_SLOT_1_A_ID=slot-1-a
FOGD_SLOT_1_B_ID=slot-1-b
FOGD_SLOT_2_A_ID=slot-2-a
FOGD_SLOT_2_B_ID=slot-2-b
FOGD_CELLD_MEMORY=512m
FOGD_CELLD_CPUS=1
FOGD_CELLD_HEAP_MB=128
FOGD_MAX_RESIDENT_CELLS=100
FOGD_MAX_REQUEST_BODY_BYTES=16777216
FOGD_MAX_REQUESTS=128
FOGD_MAX_PENDING=20
# Scoped credentials only; the legacy team token uses the global pending limit.
FOGD_MAX_PENDING_PER_CREDENTIAL=5
FOGD_MAX_ARTIFACT_BYTES=268435456
FOGD_MAX_UPLOADS=2
FOGD_MINIO_MEMORY=768m
FOGD_MINIO_CPUS=2
# Teammate CLI on another machine: FOGD_SERVER plus FOGD_DEPLOY_TOKEN only.
# FOGD_SERVER=http://127.0.0.1:8788
# Shared operation: import a valid certificate first; see docs/shared-installation.md.
FOGD_PROFILE=local
FOGD_TLS=0
# Select an alternative installation file with FOGD_ENV_FILE in the CLI environment.
# Private CA clients: NODE_EXTRA_CA_CERTS=/path/to/issuer-ca.pem
