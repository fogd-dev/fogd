         _ => Err(anyhow!("hexadecimal must be lowercase ASCII")),
     }
 }
+
+// Distinct from peer-probe and operator-request domains: identity claims cannot
+// be replayed as routing or mutation authority.
+pub(crate) fn installed_public_key() -> anyhow::Result<String> {
+    Ok(INSTALLED_SIGNER
+        .get()
+        .context("peer probe signer is not installed")?
+        .public_key_hex())
+}
+
+pub(crate) fn runtime_identity_proof(
+    challenge: &str,
+    fields: &[String; 5],
+) -> anyhow::Result<(String, String)> {
+    let message = runtime_identity_payload(challenge, fields)?;
+    let signer = INSTALLED_SIGNER
+        .get()
+        .context("peer probe signer is not installed")?;
+    Ok((
+        signer.public_key_hex(),
+        encode_hex(&signer.key.sign(message.as_bytes()).to_bytes()),
+    ))
+}
+
+fn runtime_identity_payload(challenge: &str, fields: &[String; 5]) -> anyhow::Result<String> {
+    validate_challenge(challenge)?;
+    Ok(format!(
+        "cells-runtime-identity-v2\n{challenge}\n{}",
+        serde_json::to_string(fields)?
+    ))
+}
+
+#[cfg(test)]
+mod runtime_identity_tests {
+    use super::*;
+
+    #[test]
+    fn signature_matches_cross_language_vector_and_binds_claims() {
+        let signer = PeerProbeSigner::from_secret([7_u8; 32]);
+        let fields = [
+            "a".repeat(64),
+            "b".repeat(64),
+            "c".repeat(64),
+            "d".repeat(64),
+            "27a18c4142f414227b37507c1da6e90ee6d73565eea7686152c067e2ee262ba7".to_string(),
+        ];
+        let challenge = "1".repeat(64);
+        let message = runtime_identity_payload(&challenge, &fields).unwrap();
+        let signature = signer.key.sign(message.as_bytes());
+        assert_eq!(
+            signer.public_key_hex(),
+            "ea4a6c63e29c520abef5507b132ec5f9954776aebebe7b92421eea691446d22c"
+        );
+        assert_eq!(encode_hex(&signature.to_bytes()), "22a4c58f8211ecfae6c372e79b911329965fedae6964414c40f5614dbf69985ca95b688635fd95dc877be9be685e658a164e40a29c1e6d604ef8fd0d3ba7a70a");
+        let public = signer.key.verifying_key();
+        public.verify(message.as_bytes(), &signature).unwrap();
+        let mut changed = fields.clone();
+        changed[3] = "f".repeat(64);
+        assert!(public
+            .verify(
+                runtime_identity_payload(&challenge, &changed)
+                    .unwrap()
+                    .as_bytes(),
+                &signature
+            )
+            .is_err());
+        assert!(public
+            .verify(
+                runtime_identity_payload(&"2".repeat(64), &fields)
+                    .unwrap()
+                    .as_bytes(),
+                &signature
+            )
+            .is_err());
+        assert!(runtime_identity_payload("invalid", &fields).is_err());
+    }
+}
