+fn namespace(spec: Option<&str>) -> anyhow::Result<String> {
+    let spec = spec.context("runtime identity requires a storage namespace")?;
+    let (backend, bucket, prefix) = crate::bucket::split_spec(spec);
+    anyhow::ensure!(
+        backend == crate::bucket::StorageBackend::S3 && !bucket.is_empty(),
+        "runtime identity requires an S3 namespace"
+    );
+    Ok(format!("s3://{bucket}/{}", prefix.trim_end_matches('/')))
+}
+
+fn storage_digest(namespace: &str, endpoint: Option<&str>, region: &str) -> anyhow::Result<String> {
+    let endpoint = endpoint.context("runtime identity requires an explicit S3 endpoint")?;
+    let url = url::Url::parse(endpoint).context("invalid runtime identity S3 endpoint")?;
+    anyhow::ensure!(
+        matches!(url.scheme(), "http" | "https")
+            && url.host_str().is_some()
+            && url.username().is_empty()
+            && url.password().is_none()
+            && url.query().is_none()
+            && url.fragment().is_none()
+            && url.path() == "/",
+        "runtime identity requires an HTTP(S) origin without credentials"
+    );
+    anyhow::ensure!(!region.is_empty(), "runtime identity requires a region");
+    let origin = url.origin().ascii_serialization();
+    Ok(digest(&serde_json::to_vec(&[
+        namespace,
+        origin.as_str(),
+        region,
+    ])?))
+}
+
+fn process_key_digest(key: &str) -> anyhow::Result<String> {
+    anyhow::ensure!(
+        key.len() == 64
+            && key
+                .bytes()
+                .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()),
+        "runtime identity requires the installed probe public key"
+    );
+    Ok(digest(key.as_bytes()))
+}
+
 fn digest(bytes: &[u8]) -> String {
