+// Copyright 2026 Deno Land Inc. Apache-2.0 license.
+
+//! Authenticated operations on the primary script's native cron cell.
+
+use std::time::Duration;
+
+use anyhow::{anyhow, bail};
+use serde_json::json;
+
+use crate::cli_options::FleetFlags;
+use crate::cli_output::{Format, Output};
+use crate::operator_cell::{Fleet, Reachable, Subject};
+
+pub async fn run(arguments: Vec<String>) -> anyhow::Result<()> {
+    let mut arguments = arguments.into_iter();
+    let Some(action) = arguments.next() else {
+        return Output::new(Format::Text)
+            .help("celld cron <info|pause|resume> <script> [--json] [fleet flags]");
+    };
+    if !["info", "pause", "resume"].contains(&action.as_str()) {
+        bail!("unknown celld cron command: {action}");
+    }
+    let script = arguments
+        .next()
+        .ok_or_else(|| anyhow!("cron {action} requires a script name"))?;
+    if !celld_logic::cell::valid_cell_scope(&script) || script.contains(':') {
+        bail!("invalid cron script name");
+    }
+    let mut flags = FleetFlags::default();
+    while let Some(flag) = arguments.next() {
+        if flag == "--json" {
+            continue;
+        }
+        let mut value = |name: &str| {
+            arguments
+                .next()
+                .ok_or_else(|| anyhow!("{name} requires a value"))
+        };
+        if !flags.consume(&flag, &mut value)? {
+            bail!("unknown cron flag: {flag}");
+        }
+    }
+    let storage = flags.resolve("celld cron")?;
+    let cron = Reachable::open(
+        Fleet {
+            bucket: &storage.bucket,
+            endpoint: storage.endpoint.as_deref(),
+            region: &storage.region,
+            unsafe_public_advertise: false,
+        },
+        Subject {
+            noun: "cron schedule",
+            source: "cron",
+            timeout: Duration::from_secs(60),
+        },
+        celld_logic::cron::reserved_cell(&script),
+        None,
+    )
+    .await?;
+    let reply = cron.call(json!({ "op": action })).await?;
+    Output::new(Format::Json).line(format_args!("{}", serde_json::to_string(&reply)?))
+}
