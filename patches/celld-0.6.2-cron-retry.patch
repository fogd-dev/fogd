+// Host state is cleared on settlement even when V8 termination skips JS finally.
+fn op_alarm_active(
+    scope: &mut v8::PinScope,
+    args: v8::FunctionCallbackArguments,
+    mut rv: v8::ReturnValue<v8::Value>,
+) {
+    let s = args.get(0).to_rust_string_lossy(scope);
+    rv.set(v8::Boolean::new(scope, storage::active_alarm_scheduled_time(&s).is_some()).into());
+}
