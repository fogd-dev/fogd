{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "void/env",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "pages",
    "routes",
    "db",
    "env.ts",
    "auth.ts",
    "src"
  ]
}
